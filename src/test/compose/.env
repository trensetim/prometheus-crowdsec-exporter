# Dev-only environment variables.
# DO NOT use these values outside of local development.
# In production: External Secrets Operator + Vault/1Password.

# Must match DEV_API_KEY in mock-crowdsec
CROWDSEC_API_KEY=dev-bouncer-key-12345

# Exporter config
CROWDSEC_LAPI_URL=http://mock-crowdsec:8080
METRICS_PORT=8000
POLL_INTERVAL_SECONDS=15
LOG_LEVEL=DEBUG
APP_VERSION=dev
GIT_COMMIT=local

# Grafana admin (dev only)
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=dev-grafana-pw
